FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter @ai-interview-coach/types build
RUN pnpm --filter @ai-interview-coach/shared build
RUN pnpm --filter @ai-interview-coach/ai build
RUN pnpm --filter @ai-interview-coach/web build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY --from=builder /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/package.json ./apps/web/

RUN pnpm install --prod --frozen-lockfile || pnpm install --prod

EXPOSE 3000

CMD ["pnpm", "--filter", "@ai-interview-coach/web", "start"]
