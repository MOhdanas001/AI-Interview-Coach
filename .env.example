# Global Config
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Database - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_interview_coach
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview_coach?schema=public

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Phase 2+)
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI API Key (Phase 4+)
OPENAI_API_KEY=sk-placeholder-key
